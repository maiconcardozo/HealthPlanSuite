# HealthPlan.AI.Assistant - Configurações de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais

# API Configuration
API_BASE_URL=http://localhost:5000/api
API_TIMEOUT=30

# LLM Provider (ollama ou openai)
LLM_PROVIDER=ollama

# Ollama Configuration (quando LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# OpenAI Configuration (quando LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7

# Logging
LOG_LEVEL=INFO

# Agent Configuration
MAX_ITERATIONS=10
AGENT_VERBOSE=true
