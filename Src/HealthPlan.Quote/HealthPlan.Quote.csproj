<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 
		CRITICAL: DO NOT DOWNGRADE FROM .NET 9.0!
		This business logic library REQUIRES .NET 9.0 for:
		- Entity Framework Core 9.0.x data access features
		- AutoMapper 13.x compatibility and performance
		- Latest security updates and runtime optimizations
		Always keep this as net9.0 - downgrading will break the entire solution
		-->
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<!-- 
		Package versions specifically chosen for .NET 9.0 compatibility
		WARNING: These versions require .NET 9.0 - do not downgrade the framework!
		-->
		<PackageReference Include="AutoMapper" Version="13.0.1" />
		<PackageReference Include="FluentValidation" Version="12.0.0" />
		<PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Abstractions" Version="2.3.0" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.8" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Extensions\" />
	</ItemGroup>



	<ItemGroup>
		<Compile Update="Resource\ResourceLogin.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>ResourceLogin.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resource\ResourceLogin.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>ResourceLogin.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>



</Project>
